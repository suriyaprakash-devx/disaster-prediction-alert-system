APP_ENV=production
PORT=8000
SECRET_KEY=replace_with_secure_random_secret_hex_key_32_bytes
DATABASE_URL=postgresql://user:password@hostname:5432/designops_db

GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

FRONTEND_URL=https://your-frontend.onrender.com
BACKEND_URL=https://your-backend.onrender.com

JWT_SECRET_KEY=replace_with_secure_random_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_PROVIDER=local
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_ENDPOINT_URL=

LOG_LEVEL=INFO
